SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=development

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Local development prints emails to the Django console. Do not put a real
# mailbox password in this file.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=prototype@rosana.tech
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Rosana <prototype@rosana.tech>
SERVER_EMAIL=prototype@rosana.tech
EMAIL_TIMEOUT=10

# Production / reverse-proxy settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False
DRF_ANON_RATE=100/hour
DRF_USER_RATE=2000/hour
DRF_PASSWORD_RESET_RATE=5/hour
