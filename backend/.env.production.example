# Copy these values into the deployment environment and replace every
# placeholder. Do not commit the populated file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
APP_VERSION=2026.11.0
ALLOWED_HOSTS=api.example.com

DB_NAME=rosana
DB_USER=rosana
DB_PASSWORD=replace-me
DB_HOST=postgres.example.internal
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=prototype@rosana.tech
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
DEFAULT_FROM_EMAIL=Rosana <prototype@rosana.tech>
SERVER_EMAIL=prototype@rosana.tech
EMAIL_TIMEOUT=10

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_PROTO=True

DRF_ANON_RATE=100/hour
DRF_USER_RATE=2000/hour
